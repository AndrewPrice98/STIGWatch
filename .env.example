# Environment variables, by name. Copy to backend/.env for local development (git-ignored);
# on a host such as Vercel set them in the project settings. Real environment variables win.
# Never commit real values. Comments must stay on their own lines (the .env loader keeps
# anything after the = sign). A blank value counts as unset, so copying this file as is works.

# Admin login. Create all three with: python -m stigwatch create-admin (add --print for a host)
STIGWATCH_ADMIN_USER=admin
STIGWATCH_ADMIN_PASSWORD_HASH=
STIGWATCH_SECRET_KEY=

STIGWATCH_SESSION_HOURS=8
# false only for plain-http local development
STIGWATCH_COOKIE_SECURE=true
# Reverse proxies: off by default. true trusts one proxy that sets X-Forwarded-For (Vercel);
# STIGWATCH_TRUSTED_PROXIES=<count> is for proxies that append to it. The client address is
# read from the right of the header, never the left.
STIGWATCH_TRUST_PROXY=false
# STIGWATCH_TRUSTED_PROXIES=1

# SQLite file (default backend/data/stigwatch.db)
# STIGWATCH_DB=/path/to/stigwatch.db
# Scan upload cap in MB; the Vercel entry point never allows more than 4
STIGWATCH_MAX_UPLOAD_MB=10
# Where `benchmarks import` writes a newer DISA release
# STIGWATCH_DATA_DIR=/path/to/data

# true: seed the fictional fleet, guests browse read-only
STIGWATCH_DEMO=false
# Anonymous read-only access (defaults to the demo setting; a blank value counts as unset)
# STIGWATCH_GUEST=true

# Frontend development only: where Vite forwards /api
STIGWATCH_API_URL=http://127.0.0.1:8000
